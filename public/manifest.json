{
  "manifest_version": 3,
  "name":"LyricsIT",
  "description": "Extension to search and find any song lyrics",
  "version": "1.0.5",
  "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
  },
  "action": {
    "default_popup": "../index.html"
  },
  "permissions": ["activeTab", "storage"]
}